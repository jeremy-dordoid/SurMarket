<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".FragmentProfile"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/FRGContainerPadding"
        >
        <androidx.cardview.widget.CardView
            android:layout_width="@dimen/profile_avatar_size"
            android:layout_height="@dimen/profile_avatar_size"
            android:layout_gravity="center_horizontal"
            app:cardBackgroundColor="@color/FRGInputBackground"
            app:cardCornerRadius="@dimen/profile_avatar_radius"
            app:cardElevation="0dp"
            >
            <ImageView
                android:id="@+id/IMV_FRGProfile_Avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:padding="@dimen/profile_avatar_padding"
                android:src="@drawable/ic_person"
                android:contentDescription="@string/FRGProfile_AvatarDescription"
                />
        </androidx.cardview.widget.CardView>
        <TextView
            android:id="@+id/TXV_FRGProfile_UserName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/item_marginStart"
            android:text="@string/FRGProfile_SampleUserName"
            android:textSize="@dimen/FRGTitleTextSize"
            android:textStyle="bold"
            android:textColor="@color/FRGTextPrimary"
            android:gravity="center"
            />
        <TextView
            android:id="@+id/TXV_FRGProfile_UserId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/FRGProfile_SampleUserId"
            android:textSize="@dimen/FRGTextView2TextSize"
            android:textColor="@color/FRGTextHint"
            android:gravity="center"
            android:layout_marginBottom="@dimen/FRGContainerPadding"
            />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_container"
                    android:layout_height="@dimen/profile_icon_container"
                    app:cardBackgroundColor="@color/FRGInputBackground"
                    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
                    app:cardElevation="0dp"
                    >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/profile_icon_padding"
                        android:src="@drawable/ic_email"
                        android:importantForAccessibility="no"
                        />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/item_marginStart"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_TXVEmail"
                        android:textSize="@dimen/FRGTextView2TextSize"
                        android:textColor="@color/FRGTextPrimary"
                        />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Email"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_SampleEmail"
                        android:textSize="@dimen/ITTextViewTextSize"
                        android:textColor="@color/FRGTextHint"
                        />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_container"
                    android:layout_height="@dimen/profile_icon_container"
                    app:cardBackgroundColor="@color/FRGInputBackground"
                    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
                    app:cardElevation="0dp"
                    >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/profile_icon_padding"
                        android:src="@drawable/ic_person"
                        android:importantForAccessibility="no"
                        />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/item_marginStart"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_TXVFullName"
                        android:textSize="@dimen/FRGTextView2TextSize"
                        android:textColor="@color/FRGTextPrimary"
                        />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_FullName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_SampleFullName"
                        android:textSize="@dimen/ITTextViewTextSize"
                        android:textColor="@color/FRGTextHint"
                        />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_container"
                    android:layout_height="@dimen/profile_icon_container"
                    app:cardBackgroundColor="@color/FRGInputBackground"
                    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
                    app:cardElevation="0dp"
                    >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/profile_icon_padding"
                        android:src="@drawable/ic_phone"
                        android:importantForAccessibility="no"
                        />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/item_marginStart"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_TXVPhone"
                        android:textSize="@dimen/FRGTextView2TextSize"
                        android:textColor="@color/FRGTextPrimary"
                        />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Phone"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_SamplePhone"
                        android:textSize="@dimen/ITTextViewTextSize"
                        android:textColor="@color/FRGTextHint"
                        />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_container"
                    android:layout_height="@dimen/profile_icon_container"
                    app:cardBackgroundColor="@color/FRGInputBackground"
                    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
                    app:cardElevation="0dp"
                    >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/profile_icon_padding"
                        android:src="@drawable/ic_location"
                        android:importantForAccessibility="no"
                        />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/item_marginStart"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_TXVAddress"
                        android:textSize="@dimen/FRGTextView2TextSize"
                        android:textColor="@color/FRGTextPrimary"
                        />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Address"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_SampleAddress"
                        android:textSize="@dimen/ITTextViewTextSize"
                        android:textColor="@color/FRGTextHint"
                        />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_container"
                    android:layout_height="@dimen/profile_icon_container"
                    app:cardBackgroundColor="@color/FRGInputBackground"
                    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
                    app:cardElevation="0dp"
                    >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/profile_icon_padding"
                        android:src="@drawable/ic_calendar"
                        android:importantForAccessibility="no"
                        />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/item_marginStart"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_TXVRegisterDate"
                        android:textSize="@dimen/FRGTextView2TextSize"
                        android:textColor="@color/FRGTextPrimary"
                        />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_RegisterDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_SampleRegisterDate"
                        android:textSize="@dimen/ITTextViewTextSize"
                        android:textColor="@color/FRGTextHint"
                        />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_container"
                    android:layout_height="@dimen/profile_icon_container"
                    app:cardBackgroundColor="@color/FRGInputBackground"
                    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
                    app:cardElevation="0dp"
                    >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/profile_icon_padding"
                        android:src="@drawable/ic_clock"
                        android:importantForAccessibility="no"
                        />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/item_marginStart"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_TXVLastAccess"
                        android:textSize="@dimen/FRGTextView2TextSize"
                        android:textColor="@color/FRGTextPrimary"
                        />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_LastAccess"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_SampleLastAccess"
                        android:textSize="@dimen/ITTextViewTextSize"
                        android:textColor="@color/FRGTextHint"
                        />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_container"
                    android:layout_height="@dimen/profile_icon_container"
                    app:cardBackgroundColor="@color/FRGInputBackground"
                    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
                    app:cardElevation="0dp"
                    >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/profile_icon_padding"
                        android:src="@drawable/ic_group"
                        android:importantForAccessibility="no"
                        />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/item_marginStart"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_TXVGroups"
                        android:textSize="@dimen/FRGTextView2TextSize"
                        android:textColor="@color/FRGTextPrimary"
                        />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Groups"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_SampleGroups"
                        android:textSize="@dimen/ITTextViewTextSize"
                        android:textColor="@color/FRGTextHint"
                        />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="@dimen/profile_row_margin_bottom"
                >
                <androidx.cardview.widget.CardView
                    android:layout_width="@dimen/profile_icon_container"
                    android:layout_height="@dimen/profile_icon_container"
                    app:cardBackgroundColor="@color/FRGInputBackground"
                    app:cardCornerRadius="@dimen/cardview_item_corner_radius"
                    app:cardElevation="0dp"
                    >
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:padding="@dimen/profile_icon_padding"
                        android:src="@drawable/ic_key"
                        android:importantForAccessibility="no"
                        />
                </androidx.cardview.widget.CardView>
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="@dimen/item_marginStart"
                    >
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_TXVPermissions"
                        android:textSize="@dimen/FRGTextView2TextSize"
                        android:textColor="@color/FRGTextPrimary"
                        />
                    <TextView
                        android:id="@+id/TXV_FRGProfile_Permissions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/FRGProfile_SamplePermissions"
                        android:textSize="@dimen/ITTextViewTextSize"
                        android:textColor="@color/FRGTextHint"
                        />
                </LinearLayout>
            </LinearLayout>
        <Button
            android:id="@+id/BTN_FRGProfile_ChangePassword"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:text="@string/FRGProfile_BTNChangePassword"
            android:textSize="@dimen/ITTextViewTextSize"
            android:textAllCaps="false"
            android:textColor="@color/FRGTextPrimary"
            android:paddingHorizontal="@dimen/button_padding_horizontal"
            app:backgroundTint="@color/FRGInputBackground"
            app:cornerRadius="@dimen/cardview_default_corner_radius_2"
            />
    </LinearLayout>
</ScrollView>